# Polymarket Up/Down environment template. Everything here can also be set on /control (stored in updown.db).

# OpenRouter key for the Jev / Kev / Span / Solar decision models
OPENROUTER_API_KEY=

# Telegram bot for Jev signal alerts
JEV_TELEGRAM_BOT_TOKEN=
JEV_TELEGRAM_CHAT_ID=

# Telegram bot for heartbeat (worker stalled) alerts
WATCHDOG_TELEGRAM_BOT_TOKEN=
WATCHDOG_TELEGRAM_CHAT_ID=

# Polymarket trading bot (keep simulation mode on until you have checked the forward test)
TRADER_TELEGRAM_BOT_TOKEN=
TRADER_TELEGRAM_CHAT_ID=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_TYPE=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_TOTAL_BUDGET=
POLYMARKET_PER_TRADE_AMOUNT=
POLYMARKET_SIMULATION_MODE=
POLYMARKET_RPC_URL=

# Serve the dashboard to other machines (default: local only)
ALLOW_REMOTE_ACCESS=
